{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "npm run test:unit && npm run test:components",
    "preview": "vite preview",
    "test:unit": "node --test src/services/*.test.js src/utils/*.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "test:components:watch": "vitest --config vitest.config.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
